# ==============================================================================
# AnywhereBnB Backend Environment Configuration
# ==============================================================================

# Project Name
PROJECT_NAME="Anywherebnb API"

# Database Connection (defaults to local SQLite if not provided)
DATABASE_URL=sqlite:///airbnb.db

# ==============================================================================
# Twilio Authentication & OTP Verification Configuration
# ==============================================================================
# 1. Twilio Account SID (Found on Twilio Console: https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# 2. Twilio Auth Token (Found on Twilio Console)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# 3. Twilio Outgoing Phone Number (in E.164 format, e.g. +1234567890)
# Required for Programmable SMS OTP delivery
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# 4. Twilio Verify Service SID (Optional - e.g. VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
# Recommended if you are using Twilio Verify for native SMS & Email OTPs
TWILIO_VERIFY_SERVICE_SID=

# 5. Twilio SendGrid API Key (Optional - for sending Email OTPs)
SENDGRID_API_KEY=

# 6. Twilio / SendGrid Verified Sender Email
TWILIO_EMAIL_FROM=noreply@anywherebnb.com

# 7. Mock Mode for local testing/CI without Twilio balance (set to 'false' in production)
TWILIO_MOCK_MODE=false
